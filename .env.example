# MedLit Environment Configuration
# Copy to .env and adjust as needed

# LLM Provider: "ollama" | "groq" | "stub"
LLM_PROVIDER=stub

# Ollama (local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (cloud LLM for demos)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# FHIR data directory (relative to backend working dir)
FHIR_DATA_PATH=/app/data/fhir

# Auth
AUTH_DISABLED=true

# Backend
BACKEND_PORT=8000
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
